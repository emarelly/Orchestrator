# Secrets of the Orchestrator (NFR-8, OPS-1). Installed as /etc/orchestrator/orchestrator.env,
# owned by root, mode 600. Never commit the real file. Leave a line out when you do not use it.

# Reboot of the boiler Pi over SSH (the e-mail command "reset"). A key file is preferred.
BOILER_SSH_USER=pi
BOILER_SSH_KEY_FILE=/var/lib/orchestrator/ssh/id_ed25519
#BOILER_SSH_PASSWORD=

# Home Assistant (only when [mqtt] enabled = true and a user name is set)
#MQTT_PASSWORD=

# The web page login (only when [web] login_required = true)
#UI_PASSWORD=

# Google (made by: python -m orchestrator.auth)
GOOGLE_CLIENT_SECRET_FILE=/var/lib/orchestrator/google/client_secret.json
GOOGLE_TOKEN_FILE=/var/lib/orchestrator/google/token.json
# Optional second token only for the calendar (for example the old read-only calendar token).
# When this file does not exist, GOOGLE_TOKEN_FILE is used for the calendar too.
GOOGLE_CALENDAR_TOKEN_FILE=/var/lib/orchestrator/google/calendar_token.json

# Set to 1 to build and log the files but send nothing to the boiler Pi.
#DRY_RUN=1
